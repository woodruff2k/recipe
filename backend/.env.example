# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Docker dev: host = compose service name `db`. Local(비도커): localhost:5433
# (dev compose가 host 5433 → container 5432로 공개. 5432 충돌 회피)
DATABASE_URL="postgresql://recipe:recipe@localhost:5433/recipe?schema=public"

# JWT — replace with a long random secret in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Image storage: "local" (default) or "s3" (future)
STORAGE_DRIVER=local
# Base URL used to build public image URLs when serving local files
PUBLIC_BASE_URL=http://localhost:4000
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# S3 (only required when STORAGE_DRIVER=s3) — leave blank for local dev
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
