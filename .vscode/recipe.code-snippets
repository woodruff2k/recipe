{
  // 이 프로젝트의 규약을 반영한 스니핏. 입력 후 Tab으로 자리 이동.
  "Backend: asyncHandler controller": {
    "scope": "typescript",
    "prefix": "ctrl-handler",
    "description": "asyncHandler로 감싼 컨트롤러 핸들러 (중앙 에러 핸들러로 위임)",
    "body": [
      "export const ${1:handler} = asyncHandler(async (req, res) => {",
      "\t${0}",
      "});",
    ],
  },
  "Backend: Zod schema + parse": {
    "scope": "typescript",
    "prefix": "zod-schema",
    "description": "Zod 검증 스키마 (ZodError는 중앙 핸들러가 400으로 변환)",
    "body": [
      "const ${1:name}Schema = z.object({",
      "\t${2:field}: z.string().min(1),",
      "});",
      "",
      "const ${3:data} = ${1:name}Schema.parse(req.body);$0",
    ],
  },
  "Backend: thin route file": {
    "scope": "typescript",
    "prefix": "express-route",
    "description": "컨트롤러에 위임하는 얇은 라우트 파일",
    "body": [
      "import { Router } from \"express\";",
      "import { requireAuth } from \"../middlewares/auth\";",
      "import * as ${1:item}Controller from \"../controllers/${1:item}.controller\";",
      "",
      "const router = Router();",
      "",
      "router.get(\"/\", ${1:item}Controller.list);",
      "router.get(\"/:id\", ${1:item}Controller.getOne);",
      "router.post(\"/\", requireAuth, ${1:item}Controller.create);",
      "router.put(\"/:id\", requireAuth, ${1:item}Controller.update);",
      "router.delete(\"/:id\", requireAuth, ${1:item}Controller.remove);",
      "",
      "export default router;$0",
    ],
  },
  "Frontend: client page with API fetch": {
    "scope": "typescriptreact",
    "prefix": "next-page",
    "description": "API를 직접 호출하는 use client 페이지 (lib/api 경유)",
    "body": [
      "\"use client\";",
      "",
      "import { useEffect, useState } from \"react\";",
      "import { api, ApiError } from \"@/lib/api\";",
      "",
      "export default function ${1:Page}() {",
      "\tconst [data, setData] = useState<${2:unknown} | null>(null);",
      "\tconst [error, setError] = useState<string | null>(null);",
      "",
      "\tuseEffect(() => {",
      "\t\tlet cancelled = false;",
      "\t\tasync function load() {",
      "\t\t\ttry {",
      "\t\t\t\tconst res = await api.${3:listItems}();",
      "\t\t\t\tif (!cancelled) setData(res);",
      "\t\t\t} catch (err) {",
      "\t\t\t\tif (!cancelled) setError(err instanceof ApiError ? err.message : \"오류가 발생했습니다.\");",
      "\t\t\t}",
      "\t\t}",
      "\t\tvoid load();",
      "\t\treturn () => {",
      "\t\t\tcancelled = true;",
      "\t\t};",
      "\t}, []);",
      "",
      "\tif (error) return <p className=\"text-destructive\">{error}</p>;",
      "\treturn <div>${0}</div>;",
      "}",
    ],
  },
  "Frontend: auth guard": {
    "scope": "typescriptreact",
    "prefix": "auth-guard",
    "description": "인증 안 된 사용자를 /login으로 보내는 가드",
    "body": [
      "const { user, loading } = useAuth();",
      "const router = useRouter();",
      "",
      "useEffect(() => {",
      "\tif (!loading && !user) router.replace(\"/login\");",
      "}, [loading, user, router]);$0",
    ],
  },
  "Frontend: API call with toast": {
    "scope": "typescriptreact",
    "prefix": "api-try",
    "description": "ApiError 처리 + sonner toast",
    "body": [
      "try {",
      "\tawait api.${1:method}(${2});",
      "\ttoast.success(\"${3:완료되었습니다.}\");",
      "} catch (err) {",
      "\ttoast.error(err instanceof ApiError ? err.message : \"${4:오류가 발생했습니다.}\");",
      "}$0",
    ],
  },
}
